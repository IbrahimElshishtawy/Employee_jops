generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  HR_MANAGER
  SUPERVISOR
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY_LEAVE
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceEventType {
  CHECK_IN_ATTEMPTED
  CHECK_IN_ACCEPTED
  CHECK_IN_REJECTED
  CHECK_OUT_ATTEMPTED
  CHECK_OUT_ACCEPTED
  CHECK_OUT_REJECTED
  MANUAL_CORRECTION
}

enum CheckInMethod {
  GPS
  WIFI
  BEACON
  MANUAL_HR
}

enum RequestType {
  ANNUAL_LEAVE
  SICK_LEAVE
  UNPAID_LEAVE
  EMERGENCY_LEAVE
  OFFICIAL_LEAVE
  LEAVE
  ABSENCE
  PERMISSION
  LATE_EXCUSE
  EARLY_LEAVE
  HALF_DAY
  REMOTE_WORK
  OVERTIME
}

enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  ACTIVE
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PayrollPeriodStatus {
  OPEN
  CALCULATING
  REVIEW
  FINALIZED
  LOCKED
}

enum PayrollRecordStatus {
  DRAFT
  CALCULATED
  REVIEW
  FINALIZED
  PAID
}

enum PayrollLineItemType {
  BASIC_SALARY
  ALLOWANCE
  BONUS
  OVERTIME
  LATE_DEDUCTION
  EARLY_LEAVE_DEDUCTION
  ABSENCE_DEDUCTION
  UNPAID_LEAVE_DEDUCTION
  ADVANCE_INSTALLMENT
  MANUAL_DEDUCTION
  TAX_DEDUCTION
  INSURANCE_DEDUCTION
  OTHER_DEDUCTION
}

enum DeductionType {
  LATENESS
  ABSENCE
  PENALTY
  DAMAGE
  TAX
  INSURANCE
  OTHER
}

enum NotificationType {
  ATTENDANCE_REMINDER
  REQUEST_STATUS_UPDATE
  ADVANCE_STATUS_UPDATE
  DEDUCTION_ALERT
  GENERAL_ANNOUNCEMENT
  CHAT_MESSAGE
  SYSTEM_ALERT
  ATTENDANCE
  REQUEST
  PAYROLL
  ADVANCE
  HR_MESSAGE
  ANNOUNCEMENT
  SECURITY
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  EXPIRED
  CANCELLED
}

enum AnnouncementTarget {
  ALL
  DEPARTMENT
  WORKPLACE
  EMPLOYEES
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  CHECK_IN
  CHECK_OUT
  APPROVE
  REJECT
  GOOGLE_LOGIN_SUCCESS
  GOOGLE_LOGIN_FAILED
  PROFILE_STARTED
  PROFILE_COMPLETED
  ATTENDANCE_CHECK_IN
  ATTENDANCE_CHECK_OUT
  ATTENDANCE_REJECTED
  WORKPLACE_ASSIGNED
  WORKPLACE_CHANGED
  SCHEDULE_ASSIGNED
  SCHEDULE_CHANGED
  MANUAL_ATTENDANCE_CREATED
  MANUAL_ATTENDANCE_UPDATED
  SECURITY_ATTENDANCE_REJECTED
  REQUEST_CREATED
  REQUEST_SUBMITTED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  REQUEST_MODIFIED
  LEAVE_BALANCE_UPDATED
  ATTENDANCE_UPDATED_FROM_REQUEST
  SALARY_CREATED
  SALARY_UPDATED
  SALARY_CHANGED
  ADVANCE_CREATED
  ADVANCE_APPROVED
  ADVANCE_REJECTED
  ADVANCE_PAYMENT_RECORDED
  DEDUCTION_CREATED
  PAYROLL_CALCULATED
  PAYROLL_FINALIZED
  PAYROLL_CORRECTED
  PAYROLL_LOCKED
  NOTIFICATION_PREFERENCE_UPDATED
  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_PUBLISHED
  ANNOUNCEMENT_CANCELLED
  MESSAGE_SENT
  MESSAGE_DELETED
  ORGANIZATION_CREATED
  ORGANIZATION_UPDATED
  ORGANIZATION_DELETED
  BRANCH_CREATED
  BRANCH_UPDATED
  BRANCH_DELETED
  DEPARTMENT_CREATED
  DEPARTMENT_UPDATED
  DEPARTMENT_DELETED
  SECTION_CREATED
  SECTION_UPDATED
  SECTION_DELETED
  POSITION_CREATED
  POSITION_UPDATED
  POSITION_DELETED
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_DELETED
  ROLE_ASSIGNED
  ROLE_REVOKED
  ROLE_PERMISSIONS_SYNCED
  PERMISSION_CREATED
  PERMISSION_UPDATED
  SETTING_CREATED
  SETTING_UPDATED
  SETTING_DELETED
  FEATURE_FLAG_CREATED
  FEATURE_FLAG_UPDATED
  FEATURE_FLAG_DELETED
}

enum BranchType {
  HEADQUARTERS
  BRANCH
  HOTEL
  RESORT
  FACTORY
  STORE
  OFFICE
}

enum PositionLevel {
  ENTRY
  JUNIOR
  MID
  SENIOR
  LEAD
  MANAGER
  DIRECTOR
  EXECUTIVE
}

enum SettingCategory {
  GENERAL
  ATTENDANCE
  PAYROLL
  SECURITY
  NOTIFICATIONS
  ORGANIZATION
}

enum PermissionAction {
  READ
  CREATE
  UPDATE
  DELETE
  MANAGE
  EXECUTE
}

enum PermissionSubject {
  ORGANIZATION
  BRANCH
  DEPARTMENT
  SECTION
  POSITION
  EMPLOYEES
  WORKPLACES
  ATTENDANCE
  SCHEDULES
  REQUESTS
  PAYROLL
  REPORTS
  SETTINGS
  ROLES
  PERMISSIONS
  AUDIT_LOGS
  FEATURE_FLAGS
}

// ============================================================
// CORE USER & AUTHENTICATION
// ============================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  googleId     String?    @unique
  passwordHash String?    // Nullable for pure Google Sign-In users
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  employeeProfile           EmployeeProfile?
  refreshTokens             RefreshToken[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  deviceTokens              DeviceToken[]
  auditLogs                 AuditLog[]
  approvalSteps             ApprovalStep[]
  conversationParticipants  ConversationParticipant[]
  sentMessages              ChatMessage[]
  announcementReads         AnnouncementRead[]
  userRoles                 UserRole[]

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
// EMPLOYEE & PROFILE
// ============================================================

model EmployeeProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode          String    @unique
  firstName             String
  lastName              String
  phone                 String?   @unique
  nationalId            String?   @unique
  dateOfBirth           DateTime?
  gender                Gender?
  avatarUrl             String?
  jobTitle              String
  department            String
  hireDate              DateTime  @default(now())
  baseSalary            Decimal?  @db.Decimal(12, 2)
  isProfileComplete     Boolean   @default(false)
  onboardingCompletedAt DateTime?

  // Assigned Workplace
  workplaceId String?
  workplace   Workplace? @relation(fields: [workplaceId], references: [id], onDelete: SetNull)

  // Direct Hierarchy
  managerId     String?
  manager       EmployeeProfile?  @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  directReports EmployeeProfile[] @relation("ManagerSubordinates")

  // Assigned Schedule
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // Enterprise Organizational Structure
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId   String?
  departmentRel  Department?   @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  sectionId      String?
  section        Section?      @relation("EmployeeSection", fields: [sectionId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?     @relation(fields: [positionId], references: [id], onDelete: SetNull)

  headedDepartments Department[] @relation("DepartmentHead")
  headedSections    Section[]    @relation("SectionHead")

  // Relationships
  attendances    AttendanceRecord[]
  requests       Request[]
  leaveBalances  LeaveBalance[]
  salaryProfile  SalaryProfile?
  salaryHistory  SalaryHistory[]
  advances       FinancialAdvance[]
  deductions     FinancialDeduction[]
  payrollRecords PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode])
  @@index([department])
  @@index([organizationId])
  @@index([branchId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([positionId])
  @@index([workplaceId])
  @@index([scheduleId])
  @@index([managerId])
  @@index([isProfileComplete])
  @@map("employee_profiles")
}

// ============================================================
// WORKPLACES & GEOFENCING
// ============================================================

model Workplace {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Float   @default(100.0) // Geofence radius
  wifiBssid    String? // Optional Wi-Fi BSSID constraint
  wifiIp       String? // Optional Allowed Public IP
  isActive     Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employees   EmployeeProfile[]
  attendances AttendanceRecord[]
  schedules   Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([organizationId])
  @@index([branchId])
  @@map("workplaces")
}

// ============================================================
// SCHEDULES & SHIFTS
// ============================================================

model Schedule {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  workplaceId          String?
  workplace            Workplace? @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  startTime            String   // e.g. "09:00"
  endTime              String   // e.g. "17:00"
  graceMinutesCheckIn  Int      @default(15)
  graceMinutesCheckOut Int      @default(15)
  workingDays          Int[]    // Array of day numbers: 0=Sun, 1=Mon, ..., 6=Sat
  isDefault            Boolean  @default(false)

  employees EmployeeProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedules")
}

// ============================================================
// ATTENDANCE MANAGEMENT & EVENTS
// ============================================================

model AttendanceRecord {
  id          String           @id @default(uuid())
  requestId   String?          @unique // Idempotency key from mobile client
  employeeId  String
  employee    EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workplaceId String?
  workplace   Workplace?       @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)

  checkInTime             DateTime?
  checkInLat              Float?
  checkInLng              Float?
  checkInMethod           CheckInMethod? @default(GPS)
  isCheckInWithinGeofence Boolean?       @default(true)
  checkInAccuracy         Float?         // GPS accuracy in meters

  checkOutTime             DateTime?
  checkOutLat              Float?
  checkOutLng              Float?
  checkOutMethod           CheckInMethod? @default(GPS)
  isCheckOutWithinGeofence Boolean?       @default(true)
  checkOutAccuracy         Float?

  workDurationMinutes Int?     @default(0)
  lateMinutes         Int?     @default(0)
  earlyLeaveMinutes   Int?     @default(0)
  isSuspicious        Boolean  @default(false)
  deviceSignals       Json?    // Client device telemetry

  // HR Manual Adjustment Tracking
  isManualEntry            Boolean  @default(false)
  manualCorrectionReason   String?
  manualCorrectedByUserId  String?

  notes               String?
  verifiedByUserId    String?

  events              AttendanceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([requestId])
  @@map("attendance_records")
}

model AttendanceEvent {
  id                 String              @id @default(uuid())
  requestId          String?
  attendanceRecordId String
  attendanceRecord   AttendanceRecord    @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  eventType          AttendanceEventType
  timestamp          DateTime            @default(now())
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  distanceMeters     Float?
  isWithinGeofence   Boolean?
  metadata           Json?

  createdAt DateTime @default(now())

  @@index([attendanceRecordId])
  @@index([eventType])
  @@index([requestId])
  @@index([timestamp])
  @@map("attendance_events")
}

// ============================================================
// REQUESTS & APPROVAL WORKFLOW
// ============================================================

model Request {
  id               String          @id @default(uuid())
  idempotencyKey   String?         @unique
  employeeId       String
  employee         EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             RequestType
  status           RequestStatus   @default(PENDING)

  startDate        DateTime        @db.Date
  endDate          DateTime        @db.Date
  startTime        String?         // For excuse / permission / hourly leave (e.g. "09:00")
  endTime          String?         // (e.g. "11:00")
  halfDayPeriod    HalfDayPeriod?  // FIRST_HALF, SECOND_HALF

  reason           String
  rejectionReason  String?
  attachmentUrl    String?

  reviewedByUserId String?
  reviewedAt       DateTime?

  metadata         Json?           // Extensible metadata (target attendance date, custom tags)

  approvalSteps    ApprovalStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([status])
  @@index([startDate, endDate])
  @@index([idempotencyKey])
  @@map("requests")
}

model LeaveBalance {
  id            String          @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     RequestType     @default(ANNUAL_LEAVE)
  year          Int
  totalDays     Float           @default(21)
  usedDays      Float           @default(0)
  pendingDays   Float           @default(0)
  remainingDays Float           @default(21)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
  @@map("leave_balances")
}

model ApprovalStep {
  id         String        @id @default(uuid())
  requestId  String
  request    Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId String
  approver   User          @relation(fields: [approverId], references: [id], onDelete: Cascade)
  stepOrder  Int           @default(1)
  status     RequestStatus @default(PENDING)
  comment    String?
  actionDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([approverId])
  @@map("approval_steps")
}

// ============================================================
// PAYROLL: SALARY PROFILES & HISTORY
// ============================================================

model SalaryProfile {
  id            String          @id @default(uuid())
  employeeId    String          @unique
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary   Decimal         @db.Decimal(12, 2)
  allowances    Decimal         @default(0) @db.Decimal(12, 2)
  currency      String          @default("EGP")
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  status        UserStatus      @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("salary_profiles")
}

model SalaryHistory {
  id             String          @id @default(uuid())
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  oldBasicSalary Decimal         @db.Decimal(12, 2)
  newBasicSalary Decimal         @db.Decimal(12, 2)
  oldAllowances  Decimal         @db.Decimal(12, 2)
  newAllowances  Decimal         @db.Decimal(12, 2)
  effectiveDate  DateTime
  changedById    String
  reason         String

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("salary_histories")
}

// ============================================================
// PAYROLL: ADVANCES & INSTALLMENTS
// ============================================================

model FinancialAdvance {
  id                    String              @id @default(uuid())
  idempotencyKey        String?             @unique
  employeeId            String
  employee              EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount                Decimal             @db.Decimal(12, 2)
  approvedAmount        Decimal?            @db.Decimal(12, 2)
  paidAmount            Decimal             @default(0) @db.Decimal(12, 2)
  remainingAmount       Decimal             @db.Decimal(12, 2)
  requestedInstallments Int                 @default(1)
  reason                String
  rejectionReason       String?
  status                AdvanceStatus       @default(PENDING)
  approvedById          String?
  approvedAt            DateTime?
  remarks               String?

  installments          AdvanceInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("financial_advances")
}

model AdvanceInstallment {
  id                String            @id @default(uuid())
  advanceId         String
  advance           FinancialAdvance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal           @db.Decimal(12, 2)
  dueDate           DateTime          @db.Date
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  payrollPeriodId   String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advanceId, installmentNumber])
  @@index([advanceId])
  @@index([status])
  @@index([dueDate])
  @@map("advance_installments")
}

model FinancialDeduction {
  id            String          @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          DeductionType
  amount        Decimal         @db.Decimal(12, 2)
  reason        String
  effectiveDate DateTime        @db.Date
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([type])
  @@map("financial_deductions")
}

// ============================================================
// PAYROLL: PERIODS, RECORDS & LINE ITEMS
// ============================================================

model PayrollPeriod {
  id            String              @id @default(uuid())
  name          String              @unique // e.g. "2026-08"
  startDate     DateTime            @db.Date
  endDate       DateTime            @db.Date
  status        PayrollPeriodStatus @default(OPEN)
  finalizedById String?
  finalizedAt   DateTime?

  payrollRecords PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
  @@map("payroll_periods")
}

model PayrollRecord {
  id              String              @id @default(uuid())
  employeeId      String
  employee        EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPeriodId String
  payrollPeriod   PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  basicSalary     Decimal             @db.Decimal(12, 2)
  allowances      Decimal             @db.Decimal(12, 2)
  grossSalary     Decimal             @db.Decimal(12, 2)
  totalDeductions Decimal             @db.Decimal(12, 2)
  netSalary       Decimal             @db.Decimal(12, 2)
  status          PayrollRecordStatus @default(DRAFT)

  calculatedAt    DateTime            @default(now())
  finalizedAt     DateTime?

  lineItems       PayrollLineItem[]
  adjustments     PayrollAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, payrollPeriodId])
  @@index([employeeId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_records")
}

model PayrollLineItem {
  id              String              @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord       @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            PayrollLineItemType
  name            String
  description     String?
  amount          Decimal             @db.Decimal(12, 2)
  isDeduction     Boolean             @default(false)
  source          String?             // "ATTENDANCE", "REQUEST", "ADVANCE", "MANUAL", "SALARY"
  sourceId        String?

  createdAt DateTime @default(now())

  @@index([payrollRecordId])
  @@index([type])
  @@map("payroll_line_items")
}

model PayrollAdjustment {
  id              String              @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord       @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            PayrollLineItemType
  amount          Decimal             @db.Decimal(12, 2)
  isDeduction     Boolean             @default(false)
  reason          String
  status          RequestStatus       @default(APPROVED)
  approvedById    String

  createdAt DateTime @default(now())

  @@index([payrollRecordId])
  @@map("payroll_adjustments")
}

// ============================================================
// NOTIFICATIONS & FCM DEVICE TOKENS
// ============================================================

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType     @default(SYSTEM_ALERT)
  priority  NotificationPriority @default(NORMAL)
  data      Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceNotifications   Boolean  @default(true)
  requestNotifications      Boolean  @default(true)
  payrollNotifications      Boolean  @default(true)
  advanceNotifications      Boolean  @default(true)
  announcementNotifications  Boolean  @default(true)
  messageNotifications       Boolean  @default(true)
  emailNotifications        Boolean  @default(true)
  pushNotifications         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String         @unique
  platform  DevicePlatform @default(ANDROID)
  deviceId  String?
  isActive  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([fcmToken])
  @@map("device_tokens")
}

// ============================================================
// HR ANNOUNCEMENTS & BROADCASTS
// ============================================================

model Announcement {
  id                String               @id @default(uuid())
  title             String
  body              String
  priority          NotificationPriority @default(NORMAL)
  targetType        AnnouncementTarget   @default(ALL)
  targetDepartment  String?
  targetWorkplaceId String?
  targetEmployeeIds Json?
  status            AnnouncementStatus   @default(DRAFT)
  publishedAt       DateTime?
  expiresAt         DateTime?
  createdById       String

  reads             AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetType])
  @@index([publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ============================================================
// CHAT & MESSAGING
// ============================================================

model Conversation {
  id              String   @id @default(uuid())
  title           String?
  isGroup         Boolean  @default(false)
  createdByUserId String?
  lastMessageAt   DateTime?

  participants    ConversationParticipant[]
  messages        ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(EMPLOYEE)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  deletedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([isRead])
  @@map("chat_messages")
}

// ============================================================
// AUDIT LOGGING
// ============================================================

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// ORGANIZATION & MULTI-BRANCH HIERARCHY
// ============================================================

model Organization {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  logoUrl            String?
  taxNumber          String?
  commercialRegister String?
  description        String?
  address            String?
  phone              String?
  email              String?
  currency           String   @default("EGP")
  timezone           String   @default("Africa/Cairo")
  isActive           Boolean  @default(true)

  branches           Branch[]
  departments        Department[]
  positions          Position[]
  employees          EmployeeProfile[]
  workplaces         Workplace[]
  roles              RoleRecord[]
  settings           SystemSetting[]
  featureFlags       FeatureFlag[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String       @unique
  type           BranchType   @default(BRANCH)
  address        String?
  city           String?
  country        String?      @default("Egypt")
  phone          String?
  email          String?
  latitude       Float?
  longitude      Float?
  radiusMeters   Float?       @default(100.0)
  isActive       Boolean      @default(true)

  departments    Department[]
  employees      EmployeeProfile[]
  workplaces     Workplace[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([code])
  @@index([type])
  @@index([isActive])
  @@map("branches")
}

model Department {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  parentDepartmentId String?
  parentDepartment   Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     Department[]      @relation("DepartmentHierarchy")

  headOfDepartmentId String?
  headOfDepartment   EmployeeProfile?  @relation("DepartmentHead", fields: [headOfDepartmentId], references: [id], onDelete: SetNull)

  name               String
  code               String            @unique
  description        String?
  isActive           Boolean           @default(true)

  sections           Section[]
  positions          Position[]
  employees          EmployeeProfile[] @relation("EmployeeDepartment")

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@index([parentDepartmentId])
  @@index([headOfDepartmentId])
  @@index([code])
  @@index([isActive])
  @@map("departments")
}

model Section {
  id              String            @id @default(uuid())
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  headOfSectionId String?
  headOfSection   EmployeeProfile?  @relation("SectionHead", fields: [headOfSectionId], references: [id], onDelete: SetNull)

  name            String
  code            String            @unique
  description     String?
  isActive        Boolean           @default(true)

  positions       Position[]
  employees       EmployeeProfile[] @relation("EmployeeSection")

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([departmentId])
  @@index([headOfSectionId])
  @@index([code])
  @@index([isActive])
  @@map("sections")
}

model Position {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sectionId      String?
  section        Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  title          String
  code           String            @unique
  description    String?
  level          PositionLevel     @default(MID)
  minSalary      Decimal?          @db.Decimal(12, 2)
  maxSalary      Decimal?          @db.Decimal(12, 2)
  isActive       Boolean           @default(true)

  employees      EmployeeProfile[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([code])
  @@index([level])
  @@index([isActive])
  @@map("positions")
}

// ============================================================
// RBAC & GRANULAR PERMISSIONS
// ============================================================

model Permission {
  id          String            @id @default(uuid())
  slug        String            @unique // e.g. "employees:read", "payroll:finalize"
  action      PermissionAction  @default(READ)
  subject     PermissionSubject @default(EMPLOYEES)
  description String?
  module      String            // Grouping: "organization", "attendance", "payroll", etc.

  rolePermissions RolePermission[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([slug])
  @@index([module])
  @@index([subject])
  @@index([action])
  @@map("permissions")
}

model RoleRecord {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique // e.g. "super-admin", "hr-manager", "custom-role"
  description    String?
  isSystem       Boolean          @default(false)
  isActive       Boolean          @default(true)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([slug])
  @@index([isSystem])
  @@index([isActive])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id           String      @id @default(uuid())
  roleId       String
  role         RoleRecord  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         RoleRecord  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedAt   DateTime    @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================
// SYSTEM SETTINGS & FEATURE FLAGS
// ============================================================

model SystemSetting {
  id             String          @id @default(uuid())
  key            String          @unique
  value          Json
  category       SettingCategory @default(GENERAL)
  isPublic       Boolean         @default(false)
  description    String?
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([key])
  @@index([category])
  @@index([isPublic])
  @@index([organizationId])
  @@map("system_settings")
}

model FeatureFlag {
  id                String        @id @default(uuid())
  key               String        @unique
  isEnabled         Boolean       @default(false)
  description       String?
  rolloutPercentage Int           @default(100)
  rules             Json?
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([key])
  @@index([isEnabled])
  @@index([organizationId])
  @@map("feature_flags")
}
