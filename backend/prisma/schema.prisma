// ============================================================
// CORE USER & AUTHENTICATION
// ============================================================

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  googleId     String?    @unique
  passwordHash String?    // Nullable for pure Google Sign-In users
  role         Role       @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  employeeProfile           EmployeeProfile?
  refreshTokens             RefreshToken[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  deviceTokens              DeviceToken[]
  auditLogs                 AuditLog[]
  approvalSteps             ApprovalStep[]
  conversationParticipants  ConversationParticipant[]
  sentMessages              ChatMessage[]
  announcementReads         AnnouncementRead[]
  userRoles                 UserRole[]
  delegationsCreated        ApprovalDelegation[]      @relation("Delegator")
  delegationsReceived       ApprovalDelegation[]      @relation("Delegate")
  createdTasks              Task[]                    @relation("TaskCreator")
  taskComments              TaskComment[]
  taskAttachments           TaskAttachment[]
  reviewedTaskReports       TaskReport[]              @relation("TaskReportReviewer")
  serviceRequestComments    ServiceRequestComment[]
  deviceSessions            UserDeviceSession[]
  apiKeys                   ApiKey[]
  offlineSyncItems          OfflineSyncQueue[]
  journalEntriesCreated     JournalEntry[]            @relation("JournalCreator")
  expensesCreated           FinancialExpense[]        @relation("ExpenseCreator")
  revenuesCreated           FinancialRevenue[]        @relation("RevenueCreator")
  documentsCreated          DocumentRecord[]          @relation("DocumentCreator")
  documentVersionsUploaded  DocumentVersion[]         @relation("VersionUploader")
  stockCountsConducted      StockCount[]              @relation("StockCounter")
  stockMovementsCreated     StockMovement[]           @relation("MovementCreator")

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ============================================================
// EMPLOYEE & PROFILE
// ============================================================

model EmployeeProfile {
  id                    String    @id @default(uuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeCode          String    @unique
  firstName             String
  lastName              String
  phone                 String?   @unique
  nationalId            String?   @unique
  dateOfBirth           DateTime?
  gender                Gender?
  avatarUrl             String?
  jobTitle              String
  department            String
  hireDate              DateTime  @default(now())
  baseSalary            Decimal?  @db.Decimal(12, 2)
  isProfileComplete     Boolean   @default(false)
  onboardingCompletedAt DateTime?

  // Assigned Workplace
  workplaceId String?
  workplace   Workplace? @relation(fields: [workplaceId], references: [id], onDelete: SetNull)

  // Direct Hierarchy
  managerId     String?
  manager       EmployeeProfile?  @relation("ManagerSubordinates", fields: [managerId], references: [id], onDelete: SetNull)
  directReports EmployeeProfile[] @relation("ManagerSubordinates")

  // Assigned Schedule
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  // Enterprise Organizational Structure
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId   String?
  departmentRel  Department?   @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  sectionId      String?
  section        Section?      @relation("EmployeeSection", fields: [sectionId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?     @relation(fields: [positionId], references: [id], onDelete: SetNull)

  headedDepartments Department[] @relation("DepartmentHead")
  headedSections    Section[]    @relation("SectionHead")

  // Relationships
  attendances    AttendanceRecord[]
  requests       Request[]
  leaveBalances  LeaveBalance[]
  salaryProfile  SalaryProfile?
  salaryHistory  SalaryHistory[]
  advances       FinancialAdvance[]
  deductions     FinancialDeduction[]
  payrollRecords PayrollRecord[]
  documents      EmployeeDocument[]
  onboardingWorkflow OnboardingWorkflow?
  assignedTasks      Task[]                   @relation("TaskAssignee")
  taskReports        TaskReport[]
  serviceRequestsRequested ServiceRequest[] @relation("ServiceRequestRequester")
  serviceRequestsAssigned  ServiceRequest[] @relation("ServiceRequestAssignee")
  handoversGiven           ShiftHandover[]  @relation("HandoverGiver")
  handoversReceived        ShiftHandover[]  @relation("HandoverReceiver")
  assignedAssets            Asset[]                   @relation("AssetAssignee")
  maintenanceRequests       MaintenanceRequest[]      @relation("MaintenanceRequester")
  assignedWorkOrders        WorkOrder[]               @relation("WorkOrderTechnician")
  purchaseRequests          PurchaseRequest[]         @relation("PurchaseRequester")
  reportedIncidents         SafetyIncident[]          @relation("IncidentReporter")
  investigations            IncidentInvestigation[]   @relation("IncidentInvestigator")
  correctiveActionsAssigned IncidentCorrectiveAction[] @relation("ActionAssignee")
  performanceGoals          PerformanceGoal[]
  reviewsReceived           PerformanceReview[]       @relation("EmployeeReviews")
  reviewsConducted          PerformanceReview[]       @relation("ReviewerReviews")
  trainingEnrollments       TrainingEnrollment[]
  certificates              EmployeeCertificate[]
  keyAssignments            KeyAssignment[]
  lostFoundItemsFound       LostFoundItem[]           @relation("ItemFinder")
  hostedVisitors            VisitorLog[]              @relation("VisitorHost")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeCode])
  @@index([department])
  @@index([organizationId])
  @@index([branchId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([positionId])
  @@index([workplaceId])
  @@index([scheduleId])
  @@index([managerId])
  @@index([isProfileComplete])
  @@map("employee_profiles")
}

// ============================================================
// WORKPLACES & GEOFENCING
// ============================================================

model Workplace {
  id           String  @id @default(uuid())
  name         String
  code         String  @unique
  address      String?
  latitude     Float
  longitude    Float
  radiusMeters Float   @default(100.0) // Geofence radius
  wifiBssid    String? // Optional Wi-Fi BSSID constraint
  wifiIp       String? // Optional Allowed Public IP
  isActive     Boolean @default(true)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  employees   EmployeeProfile[]
  attendances AttendanceRecord[]
  schedules   Schedule[]
  tasks       Task[]
  shiftHandovers ShiftHandover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([organizationId])
  @@index([branchId])
  @@map("workplaces")
}

// ============================================================
// SCHEDULES & SHIFTS
// ============================================================

model Schedule {
  id                   String   @id @default(uuid())
  name                 String
  description          String?
  workplaceId          String?
  workplace            Workplace? @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  startTime            String   // e.g. "09:00"
  endTime              String   // e.g. "17:00"
  graceMinutesCheckIn  Int      @default(15)
  graceMinutesCheckOut Int      @default(15)
  workingDays          Int[]    // Array of day numbers: 0=Sun, 1=Mon, ..., 6=Sat
  isDefault            Boolean  @default(false)

  employees EmployeeProfile[]
  shiftHandovers ShiftHandover[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("schedules")
}

// ============================================================
// ATTENDANCE MANAGEMENT & EVENTS
// ============================================================

model AttendanceRecord {
  id          String           @id @default(uuid())
  requestId   String?          @unique // Idempotency key from mobile client
  employeeId  String
  employee    EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workplaceId String?
  workplace   Workplace?       @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  
  date        DateTime         @db.Date
  status      AttendanceStatus @default(PRESENT)

  checkInTime             DateTime?
  checkInLat              Float?
  checkInLng              Float?
  checkInMethod           CheckInMethod? @default(GPS)
  isCheckInWithinGeofence Boolean?       @default(true)
  checkInAccuracy         Float?         // GPS accuracy in meters

  checkOutTime             DateTime?
  checkOutLat              Float?
  checkOutLng              Float?
  checkOutMethod           CheckInMethod? @default(GPS)
  isCheckOutWithinGeofence Boolean?       @default(true)
  checkOutAccuracy         Float?

  workDurationMinutes Int?     @default(0)
  lateMinutes         Int?     @default(0)
  earlyLeaveMinutes   Int?     @default(0)
  overtimeMinutes     Int?     @default(0)
  isSuspicious        Boolean  @default(false)
  deviceSignals       Json?    // Client device telemetry

  // HR Manual Adjustment Tracking
  isManualEntry            Boolean  @default(false)
  manualCorrectionReason   String?
  manualCorrectedByUserId  String?

  notes               String?
  verifiedByUserId    String?

  events              AttendanceEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([requestId])
  @@map("attendance_records")
}

model AttendanceEvent {
  id                 String              @id @default(uuid())
  requestId          String?
  attendanceRecordId String
  attendanceRecord   AttendanceRecord    @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  eventType          AttendanceEventType
  timestamp          DateTime            @default(now())
  latitude           Float?
  longitude          Float?
  accuracy           Float?
  distanceMeters     Float?
  isWithinGeofence   Boolean?
  metadata           Json?

  createdAt DateTime @default(now())

  @@index([attendanceRecordId])
  @@index([eventType])
  @@index([requestId])
  @@index([timestamp])
  @@map("attendance_events")
}

// ============================================================
// REQUESTS & APPROVAL WORKFLOW
// ============================================================

model Request {
  id               String              @id @default(uuid())
  idempotencyKey   String?             @unique
  employeeId       String
  employee         EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             RequestType
  status           RequestStatus       @default(PENDING)

  startDate        DateTime            @db.Date
  endDate          DateTime            @db.Date
  startTime        String?             // For excuse / permission / hourly leave (e.g. "09:00")
  endTime          String?             // (e.g. "11:00")
  halfDayPeriod    HalfDayPeriod?      // FIRST_HALF, SECOND_HALF

  reason           String
  rejectionReason  String?
  attachmentUrl    String?

  reviewedByUserId String?
  reviewedAt       DateTime?

  // Workflow integration
  workflowId       String?
  workflow         WorkflowDefinition? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  currentStepOrder Int                 @default(1)
  totalSteps       Int                 @default(1)

  metadata         Json?               // Extensible metadata (target attendance date, custom tags)

  approvalSteps    ApprovalStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([type])
  @@index([status])
  @@index([workflowId])
  @@index([startDate, endDate])
  @@index([idempotencyKey])
  @@map("requests")
}

model LeaveBalance {
  id            String          @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType     RequestType     @default(ANNUAL_LEAVE)
  year          Int
  totalDays     Float           @default(21)
  usedDays      Float           @default(0)
  pendingDays   Float           @default(0)
  remainingDays Float           @default(21)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, leaveType, year])
  @@index([employeeId])
  @@index([year])
  @@map("leave_balances")
}

model ApprovalStep {
  id                 String         @id @default(uuid())
  requestId          String
  request            Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approverId         String
  approver           User           @relation(fields: [approverId], references: [id], onDelete: Cascade)
  stepOrder          Int            @default(1)
  status             RequestStatus  @default(PENDING)
  action             WorkflowAction @default(APPROVE)
  comment            String?
  originalApproverId String?
  isDelegated        Boolean        @default(false)
  delegatedById      String?
  actionDate         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([approverId])
  @@index([stepOrder])
  @@map("approval_steps")
}

model WorkflowDefinition {
  id             String                   @id @default(uuid())
  name           String
  description    String?
  requestType    RequestType?
  organizationId String?
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?              @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  role           Role?
  minDays        Float?
  maxDays        Float?
  minAmount      Decimal?                 @db.Decimal(12, 2)
  maxAmount      Decimal?                 @db.Decimal(12, 2)
  priority       Int                      @default(0)
  isActive       Boolean                  @default(true)
  isDefault      Boolean                  @default(false)

  steps          WorkflowStepDefinition[]
  requests       Request[]
  serviceRequests ServiceRequest[]

  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([requestType])
  @@index([departmentId])
  @@index([organizationId])
  @@index([isActive])
  @@index([isDefault])
  @@map("workflow_definitions")
}

model WorkflowStepDefinition {
  id                   String             @id @default(uuid())
  workflowId           String
  workflow             WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepOrder            Int                @default(1)
  name                 String
  approverType         ApproverType       @default(DIRECT_MANAGER)
  role                 Role?
  specificUserId       String?
  isMandatory          Boolean            @default(true)
  canDelegate          Boolean            @default(true)
  timeoutHours         Int?
  autoApproveOnTimeout Boolean            @default(false)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
  @@map("workflow_step_definitions")
}

model ApprovalDelegation {
  id          String       @id @default(uuid())
  delegatorId String
  delegator   User         @relation("Delegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegateId  String
  delegate    User         @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)
  requestType RequestType?
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  isActive    Boolean      @default(true)
  reason      String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([delegatorId])
  @@index([delegateId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("approval_delegations")
}

// ============================================================
// PAYROLL: SALARY PROFILES & HISTORY
// ============================================================

model SalaryProfile {
  id            String          @id @default(uuid())
  employeeId    String          @unique
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  basicSalary   Decimal         @db.Decimal(12, 2)
  allowances    Decimal         @default(0) @db.Decimal(12, 2)
  currency      String          @default("EGP")
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  status        UserStatus      @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@map("salary_profiles")
}

model SalaryHistory {
  id             String          @id @default(uuid())
  employeeId     String
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  oldBasicSalary Decimal         @db.Decimal(12, 2)
  newBasicSalary Decimal         @db.Decimal(12, 2)
  oldAllowances  Decimal         @db.Decimal(12, 2)
  newAllowances  Decimal         @db.Decimal(12, 2)
  effectiveDate  DateTime
  changedById    String
  reason         String

  createdAt DateTime @default(now())

  @@index([employeeId])
  @@index([effectiveDate])
  @@map("salary_histories")
}

// ============================================================
// PAYROLL: ADVANCES & INSTALLMENTS
// ============================================================

model FinancialAdvance {
  id                    String              @id @default(uuid())
  idempotencyKey        String?             @unique
  employeeId            String
  employee              EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  amount                Decimal             @db.Decimal(12, 2)
  approvedAmount        Decimal?            @db.Decimal(12, 2)
  paidAmount            Decimal             @default(0) @db.Decimal(12, 2)
  remainingAmount       Decimal             @db.Decimal(12, 2)
  requestedInstallments Int                 @default(1)
  reason                String
  rejectionReason       String?
  status                AdvanceStatus       @default(PENDING)
  approvedById          String?
  approvedAt            DateTime?
  remarks               String?

  installments          AdvanceInstallment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("financial_advances")
}

model AdvanceInstallment {
  id                String            @id @default(uuid())
  advanceId         String
  advance           FinancialAdvance  @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  installmentNumber Int
  amount            Decimal           @db.Decimal(12, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal           @db.Decimal(12, 2)
  dueDate           DateTime          @db.Date
  status            InstallmentStatus @default(PENDING)
  paidAt            DateTime?
  payrollPeriodId   String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advanceId, installmentNumber])
  @@index([advanceId])
  @@index([status])
  @@index([dueDate])
  @@map("advance_installments")
}

model FinancialDeduction {
  id            String          @id @default(uuid())
  employeeId    String
  employee      EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          DeductionType
  amount        Decimal         @db.Decimal(12, 2)
  reason        String
  effectiveDate DateTime        @db.Date
  createdById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId])
  @@index([type])
  @@map("financial_deductions")
}

// ============================================================
// PAYROLL: PERIODS, RECORDS & LINE ITEMS
// ============================================================

model PayrollPeriod {
  id            String              @id @default(uuid())
  name          String              @unique // e.g. "2026-08"
  startDate     DateTime            @db.Date
  endDate       DateTime            @db.Date
  status        PayrollPeriodStatus @default(OPEN)
  finalizedById String?
  finalizedAt   DateTime?

  payrollRecords PayrollRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startDate, endDate])
  @@map("payroll_periods")
}

model PayrollRecord {
  id              String              @id @default(uuid())
  employeeId      String
  employee        EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  payrollPeriodId String
  payrollPeriod   PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  basicSalary     Decimal             @db.Decimal(12, 2)
  allowances      Decimal             @db.Decimal(12, 2)
  grossSalary     Decimal             @db.Decimal(12, 2)
  totalDeductions Decimal             @db.Decimal(12, 2)
  netSalary       Decimal             @db.Decimal(12, 2)
  status          PayrollRecordStatus @default(DRAFT)

  calculatedAt    DateTime            @default(now())
  finalizedAt     DateTime?

  lineItems       PayrollLineItem[]
  adjustments     PayrollAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, payrollPeriodId])
  @@index([employeeId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_records")
}

model PayrollLineItem {
  id              String              @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord       @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            PayrollLineItemType
  name            String
  description     String?
  amount          Decimal             @db.Decimal(12, 2)
  isDeduction     Boolean             @default(false)
  source          String?             // "ATTENDANCE", "REQUEST", "ADVANCE", "MANUAL", "SALARY"
  sourceId        String?

  createdAt DateTime @default(now())

  @@index([payrollRecordId])
  @@index([type])
  @@map("payroll_line_items")
}

model PayrollAdjustment {
  id              String              @id @default(uuid())
  payrollRecordId String
  payrollRecord   PayrollRecord       @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)
  type            PayrollLineItemType
  amount          Decimal             @db.Decimal(12, 2)
  isDeduction     Boolean             @default(false)
  reason          String
  status          RequestStatus       @default(APPROVED)
  approvedById    String

  createdAt DateTime @default(now())

  @@index([payrollRecordId])
  @@map("payroll_adjustments")
}

// ============================================================
// NOTIFICATIONS & FCM DEVICE TOKENS
// ============================================================

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      NotificationType     @default(SYSTEM_ALERT)
  priority  NotificationPriority @default(NORMAL)
  data      Json?
  isRead    Boolean              @default(false)
  readAt    DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendanceNotifications   Boolean  @default(true)
  requestNotifications      Boolean  @default(true)
  payrollNotifications      Boolean  @default(true)
  advanceNotifications      Boolean  @default(true)
  announcementNotifications  Boolean  @default(true)
  messageNotifications       Boolean  @default(true)
  taskNotifications          Boolean  @default(true)
  emailNotifications         Boolean  @default(true)
  pushNotifications          Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_preferences")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken  String         @unique
  platform  DevicePlatform @default(ANDROID)
  deviceId  String?
  isActive  Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([fcmToken])
  @@map("device_tokens")
}

// ============================================================
// HR ANNOUNCEMENTS & BROADCASTS
// ============================================================

model Announcement {
  id                String               @id @default(uuid())
  title             String
  body              String
  priority          NotificationPriority @default(NORMAL)
  targetType        AnnouncementTarget   @default(ALL)
  targetDepartment  String?
  targetWorkplaceId String?
  targetEmployeeIds Json?
  status            AnnouncementStatus   @default(DRAFT)
  publishedAt       DateTime?
  expiresAt         DateTime?
  createdById       String

  reads             AnnouncementRead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([targetType])
  @@index([publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ============================================================
// CHAT & MESSAGING
// ============================================================

model Conversation {
  id              String   @id @default(uuid())
  title           String?
  isGroup         Boolean  @default(false)
  createdByUserId String?
  lastMessageAt   DateTime?

  participants    ConversationParticipant[]
  messages        ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastMessageAt])
  @@map("conversations")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @default(EMPLOYEE)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ChatMessage {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  attachmentUrl  String?
  isRead         Boolean      @default(false)
  readAt         DateTime?
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  deletedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([conversationId, isRead])
  @@index([senderId])
  @@index([isRead])
  @@map("chat_messages")
}

// ============================================================
// AUDIT LOGGING
// ============================================================

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String
  entityId  String?
  payload   Json?
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// ORGANIZATION & MULTI-BRANCH HIERARCHY
// ============================================================

model Organization {
  id                 String   @id @default(uuid())
  name               String
  code               String   @unique
  logoUrl            String?
  taxNumber          String?
  commercialRegister String?
  description        String?
  address            String?
  phone              String?
  email              String?
  currency           String   @default("EGP")
  timezone           String   @default("Africa/Cairo")
  isActive           Boolean  @default(true)

  branches           Branch[]
  departments        Department[]
  positions          Position[]
  employees          EmployeeProfile[]
  workplaces         Workplace[]
  roles              RoleRecord[]
  settings           SystemSetting[]
  featureFlags       FeatureFlag[]
  jobOpenings        JobOpening[]
  workflowDefinitions WorkflowDefinition[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([code])
  @@index([isActive])
  @@map("organizations")
}

model Branch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  code           String       @unique
  type           BranchType   @default(BRANCH)
  address        String?
  city           String?
  country        String?      @default("Egypt")
  phone          String?
  email          String?
  latitude       Float?
  longitude      Float?
  radiusMeters   Float?       @default(100.0)
  isActive       Boolean      @default(true)

  departments    Department[]
  employees      EmployeeProfile[]
  workplaces     Workplace[]
  jobOpenings    JobOpening[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([code])
  @@index([type])
  @@index([isActive])
  @@map("branches")
}

model Department {
  id                 String            @id @default(uuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId           String?
  branch             Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  
  parentDepartmentId String?
  parentDepartment   Department?       @relation("DepartmentHierarchy", fields: [parentDepartmentId], references: [id], onDelete: SetNull)
  subDepartments     Department[]      @relation("DepartmentHierarchy")

  headOfDepartmentId String?
  headOfDepartment   EmployeeProfile?  @relation("DepartmentHead", fields: [headOfDepartmentId], references: [id], onDelete: SetNull)

  name               String
  code               String            @unique
  description        String?
  isActive           Boolean           @default(true)

  sections           Section[]
  positions          Position[]
  employees          EmployeeProfile[] @relation("EmployeeDepartment")
  jobOpenings        JobOpening[]
  jobOffers          JobOffer[]
  workflowDefinitions WorkflowDefinition[]
  tasks               Task[]
  serviceRequests     ServiceRequest[]
  shiftHandovers      ShiftHandover[]
  assets              Asset[]
  budgets             Budget[]
  purchaseRequests    PurchaseRequest[]
  safetyIncidents     SafetyIncident[]
  warehouses          Warehouse[]
  maintenanceRequests MaintenanceRequest[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@index([parentDepartmentId])
  @@index([headOfDepartmentId])
  @@index([code])
  @@index([isActive])
  @@map("departments")
}

model Section {
  id              String            @id @default(uuid())
  departmentId    String
  department      Department        @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  headOfSectionId String?
  headOfSection   EmployeeProfile?  @relation("SectionHead", fields: [headOfSectionId], references: [id], onDelete: SetNull)

  name            String
  code            String            @unique
  description     String?
  isActive        Boolean           @default(true)

  positions       Position[]
  employees       EmployeeProfile[] @relation("EmployeeSection")

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([departmentId])
  @@index([headOfSectionId])
  @@index([code])
  @@index([isActive])
  @@map("sections")
}

model Position {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sectionId      String?
  section        Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  title          String
  code           String            @unique
  description    String?
  level          PositionLevel     @default(MID)
  minSalary      Decimal?          @db.Decimal(12, 2)
  maxSalary      Decimal?          @db.Decimal(12, 2)
  isActive       Boolean           @default(true)

  employees      EmployeeProfile[]
  jobOpenings    JobOpening[]
  jobOffers      JobOffer[]

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([sectionId])
  @@index([code])
  @@index([level])
  @@index([isActive])
  @@map("positions")
}

// ============================================================
// RBAC & GRANULAR PERMISSIONS
// ============================================================

model Permission {
  id          String            @id @default(uuid())
  slug        String            @unique // e.g. "employees:read", "payroll:finalize"
  action      PermissionAction  @default(READ)
  subject     PermissionSubject @default(EMPLOYEES)
  description String?
  module      String            // Grouping: "organization", "attendance", "payroll", etc.

  rolePermissions RolePermission[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([slug])
  @@index([module])
  @@index([subject])
  @@index([action])
  @@map("permissions")
}

model RoleRecord {
  id             String           @id @default(uuid())
  name           String
  slug           String           @unique // e.g. "super-admin", "hr-manager", "custom-role"
  description    String?
  isSystem       Boolean          @default(false)
  isActive       Boolean          @default(true)
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([slug])
  @@index([isSystem])
  @@index([isActive])
  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  id           String      @id @default(uuid())
  roleId       String
  role         RoleRecord  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt    DateTime    @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId       String
  role         RoleRecord  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedById String?
  assignedAt   DateTime    @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================================
// SYSTEM SETTINGS & FEATURE FLAGS
// ============================================================

model SystemSetting {
  id             String          @id @default(uuid())
  key            String          @unique
  value          Json
  category       SettingCategory @default(GENERAL)
  isPublic       Boolean         @default(false)
  description    String?
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([key])
  @@index([category])
  @@index([isPublic])
  @@index([organizationId])
  @@map("system_settings")
}

model FeatureFlag {
  id                String        @id @default(uuid())
  key               String        @unique
  isEnabled         Boolean       @default(false)
  description       String?
  rolloutPercentage Int           @default(100)
  rules             Json?
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([key])
  @@index([isEnabled])
  @@index([organizationId])
  @@map("feature_flags")
}

// ============================================================
// HR & EMPLOYEE DOCUMENTS METADATA
// ============================================================

model EmployeeDocument {
  id             String               @id @default(uuid())
  employeeId     String
  employee       EmployeeProfile      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType   EmployeeDocumentType @default(OTHER)
  title          String
  documentNumber String?
  issueDate      DateTime?            @db.Date
  expiryDate     DateTime?            @db.Date
  fileUrl        String?
  fileSize       Int?
  mimeType       String?
  isVerified     Boolean              @default(false)
  verifiedById   String?
  verifiedAt     DateTime?
  notes          String?

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([employeeId])
  @@index([documentType])
  @@index([isVerified])
  @@map("employee_documents")
}

// ============================================================
// RECRUITMENT: JOB OPENINGS, CANDIDATES, APPLICATIONS, INTERVIEWS, OFFERS
// ============================================================

model JobOpening {
  id             String           @id @default(uuid())
  title          String
  code           String           @unique
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  branchId       String?
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId     String?
  position       Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  
  description    String?
  requirements   String?
  employmentType EmploymentType   @default(FULL_TIME)
  status         JobOpeningStatus @default(DRAFT)
  vacancies      Int              @default(1)
  targetDate     DateTime?        @db.Date
  minSalary      Decimal?         @db.Decimal(12, 2)
  maxSalary      Decimal?         @db.Decimal(12, 2)
  currency       String           @default("EGP")
  createdById    String?

  applications   JobApplication[]

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([departmentId])
  @@index([positionId])
  @@index([status])
  @@index([code])
  @@map("job_openings")
}

model Candidate {
  id              String            @id @default(uuid())
  firstName       String
  lastName        String
  email           String            @unique
  phone           String?
  currentTitle    String?
  experienceYears Int?              @default(0)
  source          CandidateSource   @default(DIRECT)
  resumeUrl       String?
  skills          Json?             // Array of skill strings or tag metadata
  notes           String?

  applications    JobApplication[]
  offers          JobOffer[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([email])
  @@index([phone])
  @@index([firstName, lastName])
  @@map("candidates")
}

model JobApplication {
  id              String            @id @default(uuid())
  jobOpeningId    String
  jobOpening      JobOpening        @relation(fields: [jobOpeningId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate         @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  status          ApplicationStatus @default(APPLIED)
  appliedAt       DateTime          @default(now())
  rating          Int?              @default(0)
  stageNotes      String?
  rejectionReason String?

  interviews      Interview[]
  offers          JobOffer[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([jobOpeningId, candidateId])
  @@index([jobOpeningId])
  @@index([candidateId])
  @@index([status])
  @@map("job_applications")
}

model Interview {
  id              String          @id @default(uuid())
  applicationId   String
  application     JobApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title           String
  interviewType   InterviewType   @default(HR)
  scheduledAt     DateTime
  durationMinutes Int             @default(30)
  interviewerId   String?         // User ID or EmployeeProfile ID
  locationOrLink  String?
  status          InterviewStatus @default(SCHEDULED)
  feedbackNotes   String?

  evaluations     InterviewEvaluation[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([applicationId])
  @@index([interviewerId])
  @@index([status])
  @@index([scheduledAt])
  @@map("interviews")
}

model InterviewEvaluation {
  id             String                  @id @default(uuid())
  interviewId    String
  interview      Interview               @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  evaluatorId    String                  // User ID
  rating         Int                     // 1 to 5
  criteriaScores Json?                   // Detailed criteria scores
  recommendation InterviewRecommendation @default(HIRE)
  strengths      String?
  weaknesses     String?
  comments       String?

  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@unique([interviewId, evaluatorId])
  @@index([interviewId])
  @@index([evaluatorId])
  @@map("interview_evaluations")
}

model JobOffer {
  id                String         @id @default(uuid())
  applicationId     String
  application       JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId       String
  candidate         Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  positionId        String?
  position          Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  departmentId      String?
  department        Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  
  offeredSalary     Decimal        @db.Decimal(12, 2)
  currency          String         @default("EGP")
  benefits          String?
  proposedStartDate DateTime       @db.Date
  status            JobOfferStatus @default(DRAFT)
  terms             String?
  notes             String?
  sentAt            DateTime?
  respondedAt       DateTime?
  createdById       String?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([applicationId])
  @@index([candidateId])
  @@index([status])
  @@map("job_offers")
}

// ============================================================
// ONBOARDING WORKFLOWS & CHECKLIST TASKS
// ============================================================

model OnboardingWorkflow {
  id                 String           @id @default(uuid())
  employeeId         String           @unique
  employee           EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status             OnboardingStatus @default(PENDING)
  startDate          DateTime         @default(now()) @db.Date
  targetDate         DateTime?        @db.Date
  completedAt        DateTime?
  progressPercentage Float            @default(0)
  createdById        String?

  tasks              OnboardingTask[]

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([employeeId])
  @@index([status])
  @@map("onboarding_workflows")
}

model OnboardingTask {
  id               String                 @id @default(uuid())
  workflowId       String
  workflow         OnboardingWorkflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         OnboardingTaskCategory @default(DOCUMENTATION)
  isMandatory      Boolean                @default(true)
  isCompleted      Boolean                @default(false)
  completedAt      DateTime?
  completedById    String?
  assignedToUserId String?
  dueDate          DateTime?              @db.Date
  orderIndex       Int                    @default(0)
  notes            String?

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([workflowId])
  @@index([category])
  @@index([isCompleted])
  @@map("onboarding_tasks")
}

// ============================================================
// PHASE 5: TASKS, WORK MANAGEMENT & REPORTS
// ============================================================

enum TaskStatus {
  TODO
  ACCEPTED
  IN_PROGRESS
  BLOCKED
  PENDING_REVIEW
  COMPLETED
  OVERDUE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskReportStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
}

model Task {
  id             String        @id @default(uuid())
  title          String
  description    String?
  status         TaskStatus    @default(TODO)
  priority       TaskPriority  @default(MEDIUM)
  progress       Int           @default(0) // 0 - 100 percentage
  startDate      DateTime?
  dueDate        DateTime?
  completedAt    DateTime?

  creatorId      String
  creator        User          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId     String?
  assignee       EmployeeProfile? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  departmentId   String?
  department     Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  workplaceId    String?
  workplace      Workplace?    @relation(fields: [workplaceId], references: [id], onDelete: SetNull)

  checklist      TaskChecklistItem[]
  comments       TaskComment[]
  attachments    TaskAttachment[]
  reports        TaskReport[]
  history        TaskHistory[]
  shiftHandoverItems ShiftHandoverItem[]

  metadata       Json?         // Custom labels, project tags, workflow references

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([departmentId])
  @@index([workplaceId])
  @@index([dueDate])
  @@index([createdAt])
  @@map("tasks")
}

model TaskChecklistItem {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title         String
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  orderIndex    Int       @default(0)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taskId])
  @@index([isCompleted])
  @@map("task_checklist_items")
}

model TaskComment {
  id            String    @id @default(uuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content       String
  attachmentUrl String?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
  @@map("task_comments")
}

model TaskAttachment {
  id           String   @id @default(uuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt    DateTime @default(now())

  @@index([taskId])
  @@index([uploadedById])
  @@map("task_attachments")
}

model TaskReport {
  id           String           @id @default(uuid())
  taskId       String
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employeeId   String
  employee     EmployeeProfile  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  summary      String
  challenges   String?
  hoursSpent   Float?
  progress     Int              @default(100)
  attachments  Json?            // Metadata of attachments: [{name, url, size, mimeType}]
  status       TaskReportStatus @default(SUBMITTED)

  reviewedById String?
  reviewedBy   User?            @relation("TaskReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNotes  String?
  rating       Int?             // 1 to 5

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([taskId])
  @@index([employeeId])
  @@index([status])
  @@index([reviewedById])
  @@map("task_reports")
}

model TaskHistory {
  id        String      @id @default(uuid())
  taskId    String
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String?
  action    String      // STATUS_CHANGE, ASSIGNED, REPORT_SUBMITTED, REPORT_REVIEWED, CHECKLIST_UPDATE, COMMENT_ADDED
  oldStatus TaskStatus?
  newStatus TaskStatus?
  comment   String?
  metadata  Json?

  createdAt DateTime    @default(now())

  @@index([taskId])
  @@index([createdAt])
  @@map("task_history")
}

// ============================================================
// PHASE 7: SERVICE REQUESTS, SHIFT HANDOVER & DEPARTMENT OPERATIONS
// ============================================================

enum ServiceRequestStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  UNDER_REVIEW
  CLOSED
  CANCELLED
  REJECTED
}

enum ServiceRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ServiceRequestCategory {
  IT_SUPPORT
  MAINTENANCE
  FACILITY
  EQUIPMENT
  CLEANING
  SECURITY
  LOGISTICS
  GENERAL
}

enum HandoverStatus {
  PENDING_ACKNOWLEDGEMENT
  ACKNOWLEDGED
  REJECTED
  FLAGGED
}

enum HandoverItemCategory {
  TASK
  ISSUE
  INCIDENT
  NOTE
  ASSET
  SAFETY
  GENERAL
}

enum HandoverItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ServiceRequest {
  id                 String                 @id @default(uuid())
  requestNumber      String                 @unique // e.g. "SR-2026-0001"
  title              String
  description        String
  category           ServiceRequestCategory @default(GENERAL)
  priority           ServiceRequestPriority @default(MEDIUM)
  status             ServiceRequestStatus   @default(SUBMITTED)

  requesterId        String
  requester          EmployeeProfile        @relation("ServiceRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  departmentId       String
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignedToId       String?
  assignedTo         EmployeeProfile?       @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedById       String?
  assignedAt         DateTime?

  location           String?                // Specific room/office/desk/facility area
  dueDate            DateTime?
  completedAt        DateTime?
  resolutionNotes    String?
  closedAt           DateTime?
  closedById         String?

  reviewRating       Int?                   // 1 - 5 star customer satisfaction
  reviewFeedback     String?
  rejectionReason    String?
  cancellationReason String?

  workflowId         String?
  workflow           WorkflowDefinition?    @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  currentStepOrder   Int                    @default(1)

  metadata           Json?                  // Assets, custom tags, coordinates, extra telemetry

  history            ServiceRequestHistory[]
  comments           ServiceRequestComment[]
  shiftHandoverItems ShiftHandoverItem[]

  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([requesterId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([createdAt])
  @@index([dueDate])
  @@map("service_requests")
}

model ServiceRequestHistory {
  id               String                @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest        @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  actorId          String
  action           String                // CREATED, ASSIGNED, STATUS_CHANGE, RESOLVED, REVIEWED, CLOSED, CANCELLED, REJECTED
  oldStatus        ServiceRequestStatus?
  newStatus        ServiceRequestStatus?
  notes            String?
  metadata         Json?

  createdAt        DateTime              @default(now())

  @@index([serviceRequestId])
  @@index([createdAt])
  @@map("service_request_history")
}

model ServiceRequestComment {
  id               String         @id @default(uuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  authorId         String
  author           User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content          String
  attachmentUrl    String?
  isInternal       Boolean        @default(false)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([serviceRequestId])
  @@index([authorId])
  @@map("service_request_comments")
}

model ShiftHandover {
  id                   String              @id @default(uuid())
  handoverNumber       String              @unique // e.g. "HO-2026-0001"
  shiftDate            DateTime            @db.Date
  shiftName            String              // Morning, Evening, Night, or Schedule name
  scheduleId           String?
  schedule             Schedule?           @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  departmentId         String
  department           Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  workplaceId          String?
  workplace            Workplace?          @relation(fields: [workplaceId], references: [id], onDelete: SetNull)

  handedOverById       String
  handedOverBy         EmployeeProfile     @relation("HandoverGiver", fields: [handedOverById], references: [id], onDelete: Cascade)

  receivedById         String?
  receivedBy           EmployeeProfile?    @relation("HandoverReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  status               HandoverStatus      @default(PENDING_ACKNOWLEDGEMENT)
  summary              String
  notes                String?

  acknowledgedAt       DateTime?
  acknowledgementNotes String?
  discrepancyNotes     String?

  metadata             Json?

  items                ShiftHandoverItem[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([departmentId])
  @@index([shiftDate])
  @@index([status])
  @@index([handedOverById])
  @@index([receivedById])
  @@map("shift_handovers")
}

model ShiftHandoverItem {
  id               String               @id @default(uuid())
  handoverId       String
  handover         ShiftHandover        @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  category         HandoverItemCategory @default(GENERAL)
  priority         HandoverItemPriority @default(MEDIUM)

  taskId           String?
  task             Task?                @relation(fields: [taskId], references: [id], onDelete: SetNull)

  serviceRequestId String?
  serviceRequest   ServiceRequest?      @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  isResolved       Boolean              @default(false)
  requiresAction   Boolean              @default(true)
  metadata         Json?

  createdAt        DateTime             @default(now())

  @@index([handoverId])
  @@index([taskId])
  @@index([serviceRequestId])
  @@map("shift_handover_items")
}

// ============================================================
// ASSET MANAGEMENT
// ============================================================

model AssetCategory {
  id                 String    @id @default(uuid())
  name               String
  code               String    @unique
  description        String?
  usefulLifeMonths   Int?
  depreciationRate   Decimal?  @db.Decimal(5, 2)
  assets             Asset[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([code])
  @@map("asset_categories")
}

model Asset {
  id                  String               @id @default(uuid())
  assetCode           String               @unique
  name                String
  description         String?
  categoryId          String
  category            AssetCategory        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  serialNumber        String?              @unique
  barcode             String?              @unique
  purchaseDate        DateTime?
  purchaseCost        Decimal?             @db.Decimal(12, 2)
  currentBookValue    Decimal?             @db.Decimal(12, 2)
  location            String?
  status              AssetStatus          @default(ACTIVE)
  departmentId        String?
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignedToId        String?
  assignedTo          EmployeeProfile?     @relation("AssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  warrantyExpiry      DateTime?
  metadata            Json?
  maintenanceRequests MaintenanceRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([assetCode])
  @@index([categoryId])
  @@index([departmentId])
  @@index([assignedToId])
  @@index([status])
  @@map("assets")
}

// ============================================================
// MAINTENANCE MANAGEMENT
// ============================================================

model MaintenanceRequest {
  id              String                   @id @default(uuid())
  requestNumber   String                   @unique
  title           String
  description     String
  type            MaintenanceType          @default(CORRECTIVE)
  priority        MaintenancePriority      @default(MEDIUM)
  status          MaintenanceRequestStatus @default(SUBMITTED)
  assetId         String?
  asset           Asset?                   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  requesterId     String
  requester       EmployeeProfile          @relation("MaintenanceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department               @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  scheduledDate   DateTime?
  completedAt     DateTime?
  resolutionNotes String?
  workOrders      WorkOrder[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([requestNumber])
  @@index([assetId])
  @@index([requesterId])
  @@index([departmentId])
  @@index([status])
  @@map("maintenance_requests")
}

model WorkOrder {
  id                   String               @id @default(uuid())
  orderNumber          String               @unique
  maintenanceRequestId String?
  maintenanceRequest   MaintenanceRequest?  @relation(fields: [maintenanceRequestId], references: [id], onDelete: SetNull)
  title                String
  description          String
  priority             MaintenancePriority  @default(MEDIUM)
  status               WorkOrderStatus      @default(PENDING)
  technicianId         String?
  technician           EmployeeProfile?     @relation("WorkOrderTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  estimatedHours       Decimal?             @db.Decimal(6, 2)
  actualHours          Decimal?             @db.Decimal(6, 2)
  cost                 Decimal?             @db.Decimal(12, 2)
  notes                String?
  spareParts           WorkOrderSparePart[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([orderNumber])
  @@index([maintenanceRequestId])
  @@index([technicianId])
  @@index([status])
  @@map("work_orders")
}

model SparePart {
  id             String               @id @default(uuid())
  partNumber     String               @unique
  name           String
  description    String?
  category       String?
  unitOfMeasure  String               @default("PCS")
  unitCost       Decimal              @default(0) @db.Decimal(12, 2)
  quantityOnHand Int                  @default(0)
  minQuantity    Int                  @default(5)
  workOrderParts WorkOrderSparePart[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([partNumber])
  @@map("spare_parts")
}

model WorkOrderSparePart {
  id           String    @id @default(uuid())
  workOrderId  String
  workOrder    WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  sparePartId  String
  sparePart    SparePart @relation(fields: [sparePartId], references: [id], onDelete: Cascade)
  quantityUsed Int       @default(1)
  unitCost     Decimal   @db.Decimal(12, 2)
  createdAt    DateTime  @default(now())

  @@index([workOrderId])
  @@index([sparePartId])
  @@map("work_order_spare_parts")
}

// ============================================================
// INVENTORY & STORES
// ============================================================

model Warehouse {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  location       String?
  departmentId   String?
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive       Boolean         @default(true)
  stockItems     StockItem[]
  stockMovements StockMovement[]
  stockCounts    StockCount[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([code])
  @@index([departmentId])
  @@map("warehouses")
}

model StockCategory {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  description String?
  items       StockItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([code])
  @@map("stock_categories")
}

model StockItem {
  id                   String                @id @default(uuid())
  sku                  String                @unique
  barcode              String?               @unique
  name                 String
  description          String?
  categoryId           String
  category             StockCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  warehouseId          String
  warehouse            Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  unitOfMeasure        String                @default("PCS")
  unitPrice            Decimal               @default(0) @db.Decimal(12, 2)
  costPrice            Decimal               @default(0) @db.Decimal(12, 2)
  quantityOnHand       Int                   @default(0)
  minThreshold         Int                   @default(10)
  maxThreshold         Int                   @default(500)
  reorderLevel         Int                   @default(20)
  isActive             Boolean               @default(true)
  movements            StockMovement[]
  purchaseRequestItems PurchaseRequestItem[]
  purchaseOrderItems   PurchaseOrderItem[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([sku])
  @@index([barcode])
  @@index([categoryId])
  @@index([warehouseId])
  @@map("stock_items")
}

model StockMovement {
  id             String            @id @default(uuid())
  movementNumber String            @unique
  itemId         String
  item           StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  type           StockMovementType
  quantity       Int
  referenceType  String?
  referenceId    String?
  reason         String?
  unitPrice      Decimal?          @db.Decimal(12, 2)
  createdById    String
  createdBy      User              @relation("MovementCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([movementNumber])
  @@index([itemId])
  @@index([warehouseId])
  @@index([type])
  @@map("stock_movements")
}

model StockCount {
  id             String           @id @default(uuid())
  countNumber    String           @unique
  warehouseId    String
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  status         StockCountStatus @default(DRAFT)
  conductedById  String
  conductedBy    User             @relation("StockCounter", fields: [conductedById], references: [id], onDelete: Cascade)
  countDate      DateTime         @default(now())
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([countNumber])
  @@index([warehouseId])
  @@index([status])
  @@map("stock_counts")
}

// ============================================================
// PROCUREMENT & SUPPLIERS
// ============================================================

model Supplier {
  id             String            @id @default(uuid())
  code           String            @unique
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  taxNumber      String?
  paymentTerms   String?
  rating         Decimal?          @db.Decimal(3, 2)
  isActive       Boolean           @default(true)
  purchaseOrders PurchaseOrder[]
  invoices       SupplierInvoice[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([code])
  @@map("suppliers")
}

model PurchaseRequest {
  id                 String                @id @default(uuid())
  requestNumber      String                @unique
  departmentId       String
  department         Department            @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  requesterId        String
  requester          EmployeeProfile       @relation("PurchaseRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  priority           String                @default("MEDIUM")
  status             PurchaseRequestStatus @default(DRAFT)
  requiredDate       DateTime?
  notes              String?
  totalEstimatedCost Decimal               @default(0) @db.Decimal(12, 2)
  items              PurchaseRequestItem[]
  purchaseOrders     PurchaseOrder[]
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([requestNumber])
  @@index([departmentId])
  @@index([requesterId])
  @@index([status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id                 String          @id @default(uuid())
  purchaseRequestId  String
  purchaseRequest    PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  itemId             String?
  item               StockItem?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName           String
  description        String?
  quantity           Int             @default(1)
  unitOfMeasure      String          @default("PCS")
  estimatedUnitPrice Decimal         @default(0) @db.Decimal(12, 2)
  totalPrice         Decimal         @default(0) @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())

  @@index([purchaseRequestId])
  @@index([itemId])
  @@map("purchase_request_items")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique
  purchaseRequestId    String?
  purchaseRequest      PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id], onDelete: SetNull)
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status               PurchaseOrderStatus @default(DRAFT)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  paymentTerms         String?
  subtotal             Decimal             @default(0) @db.Decimal(12, 2)
  taxAmount            Decimal             @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal             @default(0) @db.Decimal(12, 2)
  notes                String?
  items                PurchaseOrderItem[]
  invoices             SupplierInvoice[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([orderNumber])
  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId           String?
  item             StockItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemName         String
  quantityOrdered  Int           @default(1)
  quantityReceived Int           @default(0)
  unitPrice        Decimal       @default(0) @db.Decimal(12, 2)
  totalPrice       Decimal       @default(0) @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())

  @@index([purchaseOrderId])
  @@index([itemId])
  @@map("purchase_order_items")
}

model SupplierInvoice {
  id              String                @id @default(uuid())
  invoiceNumber   String                @unique
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  supplierId      String
  supplier        Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  invoiceDate     DateTime              @default(now())
  dueDate         DateTime
  subtotal        Decimal               @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal               @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal               @default(0) @db.Decimal(12, 2)
  status          SupplierInvoiceStatus @default(UNPAID)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([invoiceNumber])
  @@index([supplierId])
  @@index([status])
  @@map("supplier_invoices")
}

// ============================================================
// FINANCE & ACCOUNTING
// ============================================================

model ChartOfAccount {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  type         AccountType
  category     String
  parentId     String?
  parent       ChartOfAccount?    @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     ChartOfAccount[]   @relation("AccountTree")
  isHeader     Boolean            @default(false)
  isActive     Boolean            @default(true)
  journalLines JournalEntryLine[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([code])
  @@index([type])
  @@map("chart_of_accounts")
}

model JournalEntry {
  id          String             @id @default(uuid())
  entryNumber String             @unique
  entryDate   DateTime           @default(now())
  reference   String?
  memo        String?
  status      JournalEntryStatus @default(DRAFT)
  createdById String
  createdBy   User               @relation("JournalCreator", fields: [createdById], references: [id], onDelete: Cascade)
  lines       JournalEntryLine[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([entryNumber])
  @@index([status])
  @@index([entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String         @id @default(uuid())
  journalEntryId String
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  debit          Decimal        @default(0) @db.Decimal(12, 2)
  credit         Decimal        @default(0) @db.Decimal(12, 2)
  description    String?
  departmentId   String?
  createdAt      DateTime       @default(now())

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

model FinancialExpense {
  id            String        @id @default(uuid())
  expenseNumber String        @unique
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("SAR")
  expenseDate   DateTime      @default(now())
  status        ExpenseStatus @default(PENDING)
  departmentId  String?
  paidTo        String
  paymentMethod String        @default("BANK_TRANSFER")
  reference     String?
  description   String?
  createdById   String
  createdBy     User          @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([expenseNumber])
  @@index([status])
  @@index([category])
  @@map("financial_expenses")
}

model FinancialRevenue {
  id            String   @id @default(uuid())
  receiptNumber String   @unique
  category      String
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("SAR")
  revenueDate   DateTime @default(now())
  departmentId  String?
  receivedFrom  String
  paymentMethod String   @default("BANK_TRANSFER")
  reference     String?
  description   String?
  createdById   String
  createdBy     User     @relation("RevenueCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([receiptNumber])
  @@index([category])
  @@map("financial_revenues")
}

model BankAccount {
  id             String   @id @default(uuid())
  bankName       String
  accountNumber  String   @unique
  iban           String?  @unique
  branchName     String?
  currency       String   @default("SAR")
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  currentBalance Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([accountNumber])
  @@map("bank_accounts")
}

// ============================================================
// BUDGET MANAGEMENT
// ============================================================

model Budget {
  id             String           @id @default(uuid())
  budgetCode     String           @unique
  title          String
  fiscalYear     Int
  periodType     BudgetPeriodType @default(ANNUAL)
  startDate      DateTime
  endDate        DateTime
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  totalAllocated Decimal          @default(0) @db.Decimal(14, 2)
  totalSpent     Decimal          @default(0) @db.Decimal(14, 2)
  status         BudgetStatus     @default(DRAFT)
  notes          String?
  lines          BudgetLine[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([budgetCode])
  @@index([fiscalYear])
  @@index([departmentId])
  @@index([status])
  @@map("budgets")
}

model BudgetLine {
  id              String   @id @default(uuid())
  budgetId        String
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category        String
  allocatedAmount Decimal  @db.Decimal(12, 2)
  spentAmount     Decimal  @default(0) @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([budgetId])
  @@map("budget_lines")
}

// ============================================================
// INCIDENT & SAFETY MANAGEMENT
// ============================================================

model SafetyIncident {
  id                String                     @id @default(uuid())
  incidentNumber    String                     @unique
  title             String
  description       String
  type              IncidentType               @default(SAFETY)
  severity          IncidentSeverity           @default(MEDIUM)
  status            IncidentStatus             @default(REPORTED)
  incidentDate      DateTime                   @default(now())
  location          String
  reporterId        String
  reporter          EmployeeProfile            @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  departmentId      String?
  department        Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  evidenceUrls      String[]                   @default([])
  investigations    IncidentInvestigation[]
  correctiveActions IncidentCorrectiveAction[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([incidentNumber])
  @@index([type])
  @@index([severity])
  @@index([status])
  @@index([reporterId])
  @@map("safety_incidents")
}

model IncidentInvestigation {
  id              String          @id @default(uuid())
  incidentId      String
  incident        SafetyIncident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  investigatorId  String
  investigator    EmployeeProfile @relation("IncidentInvestigator", fields: [investigatorId], references: [id], onDelete: Cascade)
  findings        String
  rootCause       String?
  recommendations String?
  startedAt       DateTime        @default(now())
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([incidentId])
  @@index([investigatorId])
  @@map("incident_investigations")
}

model IncidentCorrectiveAction {
  id              String          @id @default(uuid())
  incidentId      String
  incident        SafetyIncident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actionTitle     String
  description     String
  assignedToId    String?
  assignedTo      EmployeeProfile? @relation("ActionAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDate         DateTime?
  status          String          @default("PENDING")
  completedAt     DateTime?
  resolutionNotes String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([incidentId])
  @@index([assignedToId])
  @@map("incident_corrective_actions")
}

// ============================================================
// DOCUMENTS MANAGEMENT
// ============================================================

model DocumentRecord {
  id             String            @id @default(uuid())
  documentNumber String            @unique
  title          String
  description    String?
  category       DocumentCategory  @default(POLICY)
  status         DocumentStatus    @default(ACTIVE)
  fileUrl        String
  fileType       String            @default("pdf")
  fileSize       Int               @default(0)
  currentVersion String            @default("1.0")
  expirationDate DateTime?
  departmentId   String?
  accessRoles    Role[]            @default([SUPER_ADMIN, HR_ADMIN, HR_MANAGER])
  createdById    String
  createdBy      User              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  versions       DocumentVersion[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([documentNumber])
  @@index([category])
  @@index([status])
  @@map("document_records")
}

model DocumentVersion {
  id            String         @id @default(uuid())
  documentId    String
  document      DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber String
  fileUrl       String
  changeSummary String?
  uploadedById  String
  uploadedBy    User           @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())

  @@index([documentId])
  @@map("document_versions")
}

// ============================================================
// PERFORMANCE MANAGEMENT
// ============================================================

model EmployeeKPI {
  id           String            @id @default(uuid())
  code         String            @unique
  title        String
  description  String?
  targetValue  Decimal           @db.Decimal(8, 2)
  unit         String            @default("PERCENT")
  category     String            @default("OPERATIONAL")
  departmentId String?
  isActive     Boolean           @default(true)
  goals        PerformanceGoal[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([code])
  @@map("employee_kpis")
}

model PerformanceGoal {
  id           String          @id @default(uuid())
  employeeId   String
  employee     EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  kpiId        String?
  kpi          EmployeeKPI?    @relation(fields: [kpiId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  targetValue  Decimal         @db.Decimal(8, 2)
  currentValue Decimal         @default(0) @db.Decimal(8, 2)
  deadline     DateTime?
  status       GoalStatus      @default(NOT_STARTED)
  weight       Int             @default(100)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([employeeId])
  @@index([kpiId])
  @@map("performance_goals")
}

model PerformanceReview {
  id            String          @id @default(uuid())
  reviewNumber  String          @unique
  employeeId    String
  employee      EmployeeProfile @relation("EmployeeReviews", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      EmployeeProfile @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Cascade)
  cycleName     String
  periodStart   DateTime
  periodEnd     DateTime
  overallRating Decimal         @db.Decimal(3, 2)
  strengths     String?
  improvements  String?
  status        ReviewStatus    @default(DRAFT)
  comments      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([reviewNumber])
  @@index([employeeId])
  @@index([reviewerId])
  @@map("performance_reviews")
}

// ============================================================
// TRAINING & DEVELOPMENT
// ============================================================

model TrainingCourse {
  id             String                @id @default(uuid())
  code           String                @unique
  title          String
  description    String
  category       TrainingCategory      @default(SERVICE)
  isMandatory    Boolean               @default(false)
  durationHours  Decimal               @db.Decimal(5, 2)
  validityMonths Int?
  isActive       Boolean               @default(true)
  sessions       TrainingSession[]
  certificates   EmployeeCertificate[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([code])
  @@map("training_courses")
}

model TrainingSession {
  id              String                @id @default(uuid())
  courseId        String
  course          TrainingCourse        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainerName     String
  startDate       DateTime
  endDate         DateTime
  location        String?
  maxParticipants Int?
  status          TrainingSessionStatus @default(SCHEDULED)
  enrollments     TrainingEnrollment[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([courseId])
  @@index([status])
  @@map("training_sessions")
}

model TrainingEnrollment {
  id                String          @id @default(uuid())
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  status            EnrollmentStatus @default(ENROLLED)
  score             Decimal?        @db.Decimal(5, 2)
  certificateIssued Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([sessionId])
  @@index([employeeId])
  @@map("training_enrollments")
}

model EmployeeCertificate {
  id                String          @id @default(uuid())
  certificateNumber String          @unique
  employeeId        String
  employee          EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId          String?
  course            TrainingCourse? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title             String
  issueDate         DateTime        @default(now())
  expiryDate        DateTime?
  certificateUrl    String?
  isRevoked         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([certificateNumber])
  @@index([employeeId])
  @@map("employee_certificates")
}

// ============================================================
// KEY & ACCESS MANAGEMENT
// ============================================================

model PhysicalKey {
  id              String          @id @default(uuid())
  keyCode         String          @unique
  keyType         KeyType         @default(ROOM)
  name            String
  location        String?
  totalCopies     Int             @default(1)
  availableCopies Int             @default(1)
  status          KeyStatus       @default(ACTIVE)
  assignments     KeyAssignment[]
  accessLogs      KeyAccessLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([keyCode])
  @@index([keyType])
  @@map("physical_keys")
}

model KeyAssignment {
  id               String              @id @default(uuid())
  keyId            String
  key              PhysicalKey         @relation(fields: [keyId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         EmployeeProfile     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt       DateTime            @default(now())
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  status           KeyAssignmentStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([keyId])
  @@index([employeeId])
  @@map("key_assignments")
}

model KeyAccessLog {
  id         String      @id @default(uuid())
  keyId      String
  key        PhysicalKey @relation(fields: [keyId], references: [id], onDelete: Cascade)
  employeeId String
  action     String
  notes      String?
  timestamp  DateTime    @default(now())

  @@index([keyId])
  @@index([employeeId])
  @@map("key_access_logs")
}

// ============================================================
// LOST & FOUND
// ============================================================

model LostFoundItem {
  id                  String          @id @default(uuid())
  itemNumber          String          @unique
  itemName            String
  description         String
  category            String          @default("GENERAL")
  locationFound       String
  foundById           String
  foundBy             EmployeeProfile @relation("ItemFinder", fields: [foundById], references: [id], onDelete: Cascade)
  foundDate           DateTime        @default(now())
  status              LostFoundStatus @default(FOUND)
  storageLocation     String
  claimantName        String?
  claimantPhone       String?
  claimantNationalId  String?
  returnedAt          DateTime?
  images              String[]        @default([])
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([itemNumber])
  @@index([status])
  @@index([foundById])
  @@map("lost_found_items")
}

// ============================================================
// VISITOR MANAGEMENT
// ============================================================

model VisitorLog {
  id                   String          @id @default(uuid())
  visitorNumber        String          @unique
  fullName             String
  phone                String
  company              String?
  nationalIdOrPassport String?
  purpose              String
  hostEmployeeId       String
  hostEmployee         EmployeeProfile @relation("VisitorHost", fields: [hostEmployeeId], references: [id], onDelete: Cascade)
  badgeNumber          String?
  checkInTime          DateTime        @default(now())
  checkOutTime         DateTime?
  status               VisitorStatus   @default(CHECKED_IN)
  remarks              String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@index([visitorNumber])
  @@index([hostEmployeeId])
  @@index([status])
  @@map("visitor_logs")
}

// ============================================================
// INTEGRATIONS & WEBHOOKS
// ============================================================

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes     String[]  @default(["read"])
  expiresAt  DateTime?
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([keyPrefix])
  @@index([userId])
  @@map("api_keys")
}

model WebhookConfig {
  id         String   @id @default(uuid())
  name       String
  targetUrl  String
  secret     String
  events     String[] @default(["*"])
  isActive   Boolean  @default(true)
  retryLimit Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("webhook_configs")
}

model IntegrationLog {
  id             String            @id @default(uuid())
  source         String
  target         String
  action         String
  status         IntegrationStatus @default(SUCCESS)
  requestPayload Json?
  responsePayload Json?
  errorMessage   String?
  durationMs     Int?
  createdAt      DateTime          @default(now())

  @@index([source])
  @@index([target])
  @@index([status])
  @@map("integration_logs")
}

// ============================================================
// DEVICE SESSIONS & OFFLINE SYNC
// ============================================================

model UserDeviceSession {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken   String         @unique
  devicePlatform DevicePlatform @default(ANDROID)
  deviceModel    String?
  osVersion      String?
  appVersion     String?
  ipAddress      String?
  userAgent      String?
  isActive       Boolean        @default(true)
  lastActiveAt   DateTime       @default(now())
  expiresAt      DateTime
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([sessionToken])
  @@map("user_device_sessions")
}

model OfflineSyncQueue {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType      String
  action          String
  clientTimestamp DateTime
  payload         Json
  status          SyncStatus @default(PENDING)
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([status])
  @@map("offline_sync_queue")
}



