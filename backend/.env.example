# ============================================================
# CYBERWISE IE — ENVIRONMENT CONFIGURATION
# ============================================================

# App Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=CyberWise-IE-Backend
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cyberwise_db?schema=public"

# Redis Configuration (Optional / Local Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=cyberwise_super_secure_access_secret_key_2026_production_grade
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=cyberwise_super_secure_refresh_secret_key_2026_production_grade
JWT_REFRESH_EXPIRATION=7d

# Security & CORS
CORS_ORIGINS=*
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Firebase Cloud Messaging (FCM) Configuration
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
